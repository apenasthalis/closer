# Credenciais locais do PostgreSQL usadas pelo Compose.
POSTGRES_USER=closer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=closer

# Token interno compartilhado entre Laravel e o agente restrito de Docker.
# Use um valor aleatório com pelo menos 32 caracteres em qualquer ambiente compartilhado.
DOCKER_CONTROL_TOKEN=change-me-with-a-long-random-token
